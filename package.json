{
  "name": "pizza",
  "version": "2.1.0",
  "description": "Personal Pi distribution package with skills, support configuration, and optional community packages",
  "keywords": ["pi-package"],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node tests/pizza.integration.mjs && node tests/codex-multi-account.integration.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/pizza.ts",
      "./extensions/codex-multi-account/index.ts"
    ],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
